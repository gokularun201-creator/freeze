    .line 94
    const-string v0, "1. Overview & Scope"

    .line 95
    const-string v1, "Freeze AGI (\"we\", \"our\", or \"the App\") is engineered with a strict privacy-by-design architecture. Freeze AGI processes voice commands and automations locally on your device. We do not require account registration, do not maintain remote cloud user profiles, and do not monetize, rent, or sell your personal data."

    const/16 v2, 0x36

    .line 93
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 99
    const-string v0, "2. Android AccessibilityService API Disclosure"

    .line 100
    const-string v1, "Freeze AGI requests access to the Android AccessibilityService API solely to perform user-commanded navigation and touch interactions on your behalf:\n\u2022 Purpose: To click buttons, type text, and scroll through screens when you issue explicit voice commands (e.g. \"Click search\", \"Scroll down\", \"Open YouTube\").\n\u2022 Strict Data Protection: Freeze AGI NEVER logs, collects, or transmits sensitive user inputs such as passwords, credit card numbers, personal communications, or financial credentials.\n\u2022 Local Processing: Screen hierarchy inspection occurs ephemerally in volatile device memory and is immediately released once the action completes."

    .line 98
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 104
    const-string v0, "3. Audio Recording & Microphone Usage"

    .line 105
    const-string v1, "Freeze AGI uses the RECORD_AUDIO permission strictly when you tap the voice button or activate background wake word listening (\"Hey Freeze\") to transcribe voice commands into automation intents. Audio streams are processed in device memory via on-device speech models or system speech engines and are never uploaded to advertisers or third-party tracking networks."

    .line 103
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 109
    const-string v0, "4. Cloud AI & Google Gemini API Integration"

    .line 110
    const-string v1, "When you use conversational reasoning or web knowledge queries, Freeze AGI connects directly over an encrypted TLS/HTTPS link to Google\'s official Gemini API servers using your provided personal API key (Bring Your Own Key model). No intermediary proxy server intercepts your prompts. Your API key is stored securely in encrypted private device storage."

    .line 108
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 114
    const-string v0, "5. Phone State, Call Management & Contacts"

    .line 115
    const-string v1, "Phone state and contacts permissions are used locally and on-demand to identify incoming callers for hands-free voice answering or declining, and to initiate voice calls upon your explicit command. Phone audio is NEVER recorded, listened to, or stored on remote servers."

    .line 113
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 119
    const-string v0, "6. Camera & System Tools"

    .line 120
    const-string v1, "Camera hardware access is utilized strictly to toggle the device flashlight upon spoken request (\"turn on flashlight\"). Freeze AGI does not capture background photos, videos, or surveillance."

    .line 118
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 124
    const-string v0, "7. Floating Overlay & Foreground Services"

    .line 125
    const-string v1, "Display Over Other Apps (SYSTEM_ALERT_WINDOW) allows the floating assistant bubble and HUD to appear above other apps when invoked. A standard persistent Android notification is shown whenever background listening or overlay services are active, providing immediate status visibility and a one-tap stop button."

    .line 123
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 129
    const-string v0, "8. Data Retention & Deletion Policy"

    .line 130
    const-string v1, "Because Freeze AGI does not maintain cloud accounts or remote servers, all your data lives strictly on your device:\n\u2022 You can permanently erase all local settings, preferences, custom voice configurations, and logs at any time via Android Settings > Apps > Freeze AGI > Storage > Clear Storage / Clear Data.\n\u2022 Uninstalling the app permanently deletes 100% of stored app files and preferences."

    .line 128
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 134
    const-string v0, "9. Third-Party Services & No Advertisements"

    .line 135
    const-string v1, "Freeze AGI contains zero third-party advertising SDKs, cross-app tracking libraries, or data analytics brokers. Your usage remains private and confined to your device and your chosen AI endpoint."

    .line 133
    invoke-static {v0, v1, v5, v2}, Lcom/freeze/assistant/ui/screens/PrivacyPolicyScreenKt;->access$PolicySection(Ljava/lang/String;Ljava/lang/String;Landroidx/compose/runtime/Composer;I)V

    .line 139
    const-string v0, "10. User Control & Permission Revocation"

    .line 140
